# Copy to .env (read by `datalens serve` and docker compose).

# Which model the API calls: "openai" = any OpenAI-compatible server (vLLM), or "anthropic".
DATALENS_BACKEND=openai
DATALENS_MODEL=datalens
DATALENS_BASE_URL=http://localhost:8001/v1

# For DATALENS_BACKEND=anthropic, and for evaluating the frontier models.
ANTHROPIC_API_KEY=

# Serving behaviour
DATALENS_DB_DIR=data/databases
DATALENS_SAMPLES=5
DATALENS_MAX_ROWS=500
DATALENS_QUERY_TIMEOUT_S=15

# Hugging Face (gated models, pushing checkpoints)
HF_TOKEN=
